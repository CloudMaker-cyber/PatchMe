# 复制为 .env 并填入本地随机值；真实密钥不得提交 Git、不得发给 AI。
# 生产环境必须使用不同的强密码与不同 JWT 密钥（见 docs/v3/04）。

# --- MySQL（docker-compose 与后端共用，任务 2 起 Flyway 使用） ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=patchme
DB_USERNAME=patchme_app
DB_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# --- 后端 ---
# 允许的前端源，多个用逗号分隔
APP_CORS_ORIGINS=http://localhost:5173
# 任务 2 启用 JWT 后使用：至少 32 字节随机字符串
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM
