# 复制为 .env 并填入本地随机值；真实密钥不得提交 Git、不得发给 AI。
# 生产环境必须使用不同的强密码与不同 JWT 密钥（见 docs/v3/04）。

# --- MySQL（docker-compose 与后端共用，任务 2 起 Flyway 使用） ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=patchme
DB_USERNAME=patchme_app
DB_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# --- 后端 ---
# 允许的前端源，多个用逗号分隔
APP_CORS_ORIGINS=http://localhost:5173
# 任务 2 启用 JWT 后使用：至少 32 字节随机字符串
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM

# --- 任务 6 生产部署补充（详见 docs/deploy-production.md） ---
# 后端 profile：本机开发留空；生产容器里由 compose.prod 固定为 prod
SPRING_PROFILES_ACTIVE=
# HTTPS 就绪后置 true（prod 下默认即 true），HttpOnly Cookie 会同时带 Secure 标志
APP_COOKIE_SECURE=false
# 生产前端源，逗号分隔，例如 https://patchme.example.com
PROD_CORS_ORIGINS=CHANGE_ME_HTTPS_ORIGIN
